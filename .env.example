# Skopiuj ten plik jako .env i uzupełnij wartości.
# .env jest w .gitignore — nigdy nie commituj prawdziwych kluczy.

# Klucz Google Maps Platform.
# Wymagane API: Maps JavaScript API (Street View + biblioteka maps3d), Elevation API.
# Klucz jest widoczny w bundlu przeglądarki — ogranicz go w Google Cloud Console
# restrykcją HTTP referrer na swoje domeny oraz localhost.
VITE_GOOGLE_MAPS_API_KEY=

# Host serwera PartyKit.
# Lokalnie zostaw pusty lub zakomentowany — kod domyślnie użyje localhost:1999.
# Po wdrożeniu (npx partykit deploy) wpisz tu zwrócony adres.
# VITE_PARTYKIT_HOST=twoj-projekt.uzytkownik.partykit.dev
